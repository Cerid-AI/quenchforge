<?xml version="1.0" encoding="UTF-8"?>
<!--
  Quenchforge LaunchAgent — for operators who built from source.
  Operators on Homebrew get this automatically via `brew services start
  quenchforge`; that path is preferred. This template is for the
  source-build case (or anyone who wants per-user supervision without
  a Homebrew install).

  Install (this template is embedded in the binary; `install` writes it
  with your $USER substituted, so prefer it over copying by hand):
    quenchforge install

  Edit ~/Library/LaunchAgents/com.cerid.quenchforge.plist to set the
  model env vars to GGUF filenames that exist under ~/.quenchforge/models/
  — `quenchforge list` shows what is installed and `quenchforge doctor`
  marks a configured slot whose model is missing.

  Load (the bootstrap flow `quenchforge install` prints):
    launchctl bootout gui/$(id -u)/com.cerid.quenchforge 2>/dev/null || true
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.cerid.quenchforge.plist

  Check:
    launchctl list | grep com.cerid.quenchforge
    curl http://127.0.0.1:11434/health

  Logs:
    tail -F ~/Library/Logs/quenchforge/quenchforge.out.log

  KeepAlive is <dict><key>SuccessfulExit</key><false/></dict>: launchd
  restarts the daemon after a crash (Vega II prompt-cache crash, kill -9,
  OS upgrade) but leaves a clean exit alone, because serve exits 0 with an
  actionable message when it deliberately yields — a held port, or a set
  of slots that cannot fit in VRAM. To stop it on purpose, boot the job
  out of supervision with `launchctl bootout`.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cerid.quenchforge</string>

    <!--
      ProgramArguments[0] is the prestart guard, not quenchforge directly.
      The guard reclaims port 11434 from a squatter (typically Ollama.app's
      auto-launched `ollama serve`) before exec'ing `quenchforge serve`, so
      quenchforge stays authoritative on the canonical Ollama-API port
      across restarts and logins without the operator hand-evicting Ollama.
      `quenchforge install` writes the guard to ~/.config/quenchforge/.
      Operators who intentionally run Ollama can replace these two lines
      with the bare binary path + `serve`.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/REPLACE_ME/.config/quenchforge/prestart-guard.sh</string>
        <string>serve</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <!--
          /usr/sbin carries ioreg and sysctl, which the GPU governor probes
          for display power and memory pressure. Without it those probes do
          not run and the governor holds a conservative plan on unmeasured
          data (it says so in the log).
        -->
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin</string>

        <!--
          Each value is a GGUF filename (without .gguf) under
          ~/.quenchforge/models/. A slot whose model is not on disk is
          NOT started and its lane returns 503 — serve says so at
          startup and `quenchforge doctor` marks it MISSING — so only
          name models you have pulled.

          The chat default is what `quenchforge pull llama3.2:3b`
          installs, which is the pull install.sh tells you to run. Swap
          in a larger model (`quenchforge pull qwen2.5:7b` installs
          qwen2.5-7b-instruct-q4_k_m) once it is downloaded.
        -->
        <key>QUENCHFORGE_DEFAULT_MODEL</key>
        <string>llama-3.2-3b-instruct-q4_k_m</string>

        <!--
          Embed and rerank are opt-in. Pull the model first, then put its
          filename here:
            quenchforge pull nomic-embed:v1.5
            quenchforge pull bge-reranker:v2-m3
          `quenchforge list` prints the on-disk name each one installed.
        -->
        <key>QUENCHFORGE_EMBED_MODEL</key>
        <string></string>

        <key>QUENCHFORGE_RERANK_MODEL</key>
        <string></string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!--
      Restart only on crashes (non-zero exit), never on clean exits.
      The pre-bind port-check path in cmdServe exits 0 with an actionable
      message when the port is held by Ollama or a stale quenchforge —
      KeepAlive=<true/> would respawn-loop on that, defeating the
      operator-friendly error. SuccessfulExit=false keeps the supervisor
      restart-on-crash semantics while letting clean exits stick. With the
      prestart guard reclaiming the port first, that yield path now only
      triggers when a squatter cannot be evicted (e.g. another user's
      process), which is the correct time to surface the error and stop.
    -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Don't thrash if the binary crash-loops; back off 10s between starts. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/REPLACE_ME/Library/Logs/quenchforge/quenchforge.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/REPLACE_ME/Library/Logs/quenchforge/quenchforge.err.log</string>

    <!-- Working dir is your home so the daemon resolves ~/.quenchforge/ correctly. -->
    <key>WorkingDirectory</key>
    <string>/Users/REPLACE_ME</string>

    <!--
      "Interactive" lets the daemon use the GPU via Metal (background
      tier is restricted). This matches the user-experience tier of
      `ollama serve` running in the foreground.
    -->
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
